# Public canonical URL (canonical tags, sitemap, Open Graph). Leave UNSET on Vercel: the project's
# production domain is used automatically. Only set it once that domain really serves this site —
# pointing it at a domain still showing another site tells Google to ignore this one.
NEXT_PUBLIC_SITE_URL=

# Search engine ownership codes (HTML-tag method, just the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form delivery (server-side only — never prefix with NEXT_PUBLIC_)
# Without these, the form returns a clear "not configured" error in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=adv.vageshsamvedi@gmail.com
CONTACT_FROM_EMAIL=Website <noreply@vageshsamvedi.com>

# Appointment booking (Google Calendar + Gmail, free). Server-side only — never prefix with NEXT_PUBLIC_.
# See README → "Google setup". Without these, the chat still answers questions and says online booking is unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once from /api/google/connect?key=… after signing in as the calendar owner
GOOGLE_REFRESH_TOKEN=
# Optional: defaults to the connected account's primary calendar
GOOGLE_CALENDAR_ID=
# Private setup key (16+ characters) protecting /api/google/connect and /api/google/status
GOOGLE_CONNECT_KEY=
# Where new-booking notifications are sent (sent from the connected Gmail account)
APPOINTMENT_NOTIFY_EMAIL=kkichusolanki@gmail.com
